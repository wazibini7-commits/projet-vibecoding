// Modèle de données Vanlife — étape 1 de la feuille de route (base de données).
// Conventions :
//   - noms de modèles et de champs en français, comme dans le frontend (src/domain/types.ts) ;
//   - tables en snake_case dans PostgreSQL (@@map / @map) ;
//   - montants en CENTIMES (entiers) pour éviter les erreurs d'arrondi ;
//   - dates calendaires (départ, retour) en type DATE, sans heure ni fuseau.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Offre ----------

model Sejour {
  id                 String              @id // identifiant lisible, ex. « bretagne-sauvage »
  nom                String
  accroche           String
  destination        String
  dureeJours         Int                 @map("duree_jours")
  dureeNuits         Int                 @map("duree_nuits")
  public             String
  nombreVoyageurs    Int                 @map("nombre_voyageurs")
  villeDepart        String              @map("ville_depart")
  villeRetour        String              @map("ville_retour")
  prixCentimes       Int                 @map("prix_centimes") // prix pour l'ensemble des voyageurs
  devise             String              @default("EUR")
  prixAConfirmer     Boolean             @default(true) @map("prix_a_confirmer")
  elementsAConfirmer String[]            @map("elements_a_confirmer")
  presentationVan    String              @default("") @map("presentation_van")
  publie             Boolean             @default(false) // visible sur le site public
  programme          JourProgramme[]
  questions          QuestionFrequente[]
  equipementsVan     EquipementVan[]
  prestations        Prestation[]
  departs            Depart[]
  creeLe             DateTime            @default(now()) @map("cree_le")
  modifieLe          DateTime            @updatedAt @map("modifie_le")

  @@map("sejours")
}

model JourProgramme {
  id                Int      @id @default(autoincrement())
  sejourId          String   @map("sejour_id")
  sejour            Sejour   @relation(fields: [sejourId], references: [id], onDelete: Cascade)
  jour              Int // 1 = jour du départ
  titre             String
  description       String
  lieuNuit          String?  @map("lieu_nuit") // null : pas de nuit (dernier jour)
  nuitAConfirmer    Boolean  @default(true) @map("nuit_a_confirmer")
  distanceKm        Int?     @map("distance_km") // trajet du jour, estimé hors arrêts
  dureeRouteMinutes Int?     @map("duree_route_minutes")
  activites         String[]

  @@unique([sejourId, jour])
  @@map("jours_programme")
}

/// Question fréquente affichée sur le site (et utilisée par l'assistant).
model QuestionFrequente {
  id         Int     @id @default(autoincrement())
  sejourId   String  @map("sejour_id")
  sejour     Sejour  @relation(fields: [sejourId], references: [id], onDelete: Cascade)
  ordre      Int
  question   String
  reponse    String
  aConfirmer Boolean @default(true) @map("a_confirmer") // règle encore à valider par Vanlife

  @@index([sejourId])
  @@map("questions_frequentes")
}

/// Équipement du van proposé pour le séjour (indicatif tant que le modèle n'est pas arrêté).
model EquipementVan {
  id        Int    @id @default(autoincrement())
  sejourId  String @map("sejour_id")
  sejour    Sejour @relation(fields: [sejourId], references: [id], onDelete: Cascade)
  ordre     Int
  categorie String
  detail    String

  @@index([sejourId])
  @@map("equipements_van")
}

enum TypePrestation {
  INCLUSE // comprise dans le prix
  A_PREVOIR // à la charge du client

  @@map("type_prestation")
}

model Prestation {
  id       Int            @id @default(autoincrement())
  sejourId String         @map("sejour_id")
  sejour   Sejour         @relation(fields: [sejourId], references: [id], onDelete: Cascade)
  type     TypePrestation
  libelle  String
  ordre    Int            @default(0) // ordre d'affichage

  @@index([sejourId, type])
  @@map("prestations")
}

enum StatutDepart {
  OUVERT
  COMPLET
  FERME

  @@map("statut_depart")
}

/// Une date de départ proposée pour un séjour, avec le nombre de vans disponibles.
model Depart {
  id        Int          @id @default(autoincrement())
  sejourId  String       @map("sejour_id")
  sejour    Sejour       @relation(fields: [sejourId], references: [id], onDelete: Cascade)
  date      DateTime     @db.Date
  capacite  Int          @default(1) // nombre de vans (donc de demandes acceptables)
  statut    StatutDepart @default(OUVERT)
  demandes  Demande[]
  creeLe    DateTime     @default(now()) @map("cree_le")
  modifieLe DateTime     @updatedAt @map("modifie_le")

  @@unique([sejourId, date])
  @@index([date])
  @@map("departs")
}

// ---------- Clients et demandes ----------

model Client {
  id                 String    @id @default(uuid()) @db.Uuid
  prenom             String
  nom                String?
  email              String    @unique // toujours enregistré en minuscules
  telephone          String?
  consentementRgpdLe DateTime? @map("consentement_rgpd_le") // date d'acceptation de la politique de confidentialité
  demandes           Demande[]
  creeLe             DateTime  @default(now()) @map("cree_le")
  modifieLe          DateTime  @updatedAt @map("modifie_le")

  @@map("clients")
}

enum StatutDemande {
  RECUE // vient d'être envoyée par le client
  EN_ETUDE // prise en charge par Vanlife
  CONFIRMEE
  REFUSEE
  ANNULEE

  @@map("statut_demande")
}

model Demande {
  id              String             @id @default(uuid()) @db.Uuid
  reference       String             @unique // ex. VL-2027-0042, communiquée au client
  clientId        String             @map("client_id") @db.Uuid
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Restrict)
  departId        Int                @map("depart_id")
  depart          Depart             @relation(fields: [departId], references: [id], onDelete: Restrict)
  dateRetour      DateTime           @map("date_retour") @db.Date
  nombreVoyageurs Int                @map("nombre_voyageurs")
  prixCentimes    Int                @map("prix_centimes") // prix indicatif au moment de la demande (figé)
  message         String?
  noteInterne     String?            @map("note_interne") // visible uniquement par Vanlife
  statut          StatutDemande      @default(RECUE)
  historique      HistoriqueStatut[]
  emails          EmailSortant[]
  accesSuivi      AccesSuivi[]
  messages        MessageDemande[]
  creeLe          DateTime           @default(now()) @map("cree_le")
  modifieLe       DateTime           @updatedAt @map("modifie_le")

  @@index([statut])
  @@index([departId])
  @@index([clientId])
  @@map("demandes")
}

// ---------- Administration ----------

enum Role {
  ADMIN
  GESTIONNAIRE

  @@map("role")
}

model Utilisateur {
  id                String             @id @default(uuid()) @db.Uuid
  email             String             @unique
  nom               String
  motDePasseHash    String             @map("mot_de_passe_hash") // jamais le mot de passe en clair (argon2, étape 5)
  role              Role               @default(GESTIONNAIRE)
  actif             Boolean            @default(true)
  changementsStatut HistoriqueStatut[]
  sessions          Session[]
  messages          MessageDemande[]
  creeLe            DateTime           @default(now()) @map("cree_le")
  derniereConnexion DateTime?          @map("derniere_connexion")

  @@map("utilisateurs")
}

/// Session de connexion au back-office. Le cookie contient un jeton aléatoire ; la base n'en garde
/// que l'empreinte (SHA-256) : une fuite de la base ne permet pas d'usurper une session.
model Session {
  id            String      @id // empreinte SHA-256 du jeton
  utilisateurId String      @map("utilisateur_id") @db.Uuid
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  creeLe        DateTime    @default(now()) @map("cree_le")
  expireLe      DateTime    @map("expire_le")

  @@index([utilisateurId])
  @@index([expireLe])
  @@map("sessions")
}

/// Trace de chaque changement de statut d'une demande : qui, quand, de quoi vers quoi.
model HistoriqueStatut {
  id            Int            @id @default(autoincrement())
  demandeId     String         @map("demande_id") @db.Uuid
  demande       Demande        @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  ancienStatut  StatutDemande? @map("ancien_statut") // nul à la création
  nouveauStatut StatutDemande  @map("nouveau_statut")
  auteurId      String?        @map("auteur_id") @db.Uuid // nul = le client ou le système
  auteur        Utilisateur?   @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  commentaire   String?
  creeLe        DateTime       @default(now()) @map("cree_le")

  @@index([demandeId])
  @@map("historique_statuts")
}

// ---------- E-mails ----------

enum TypeEmail {
  ACCUSE_RECEPTION // au client : « nous avons bien reçu votre demande »
  NOTIFICATION_VANLIFE // à l'équipe Vanlife : « nouvelle demande »
  CHANGEMENT_STATUT // au client : demande confirmée, refusée…
  LIEN_SUIVI // au client : nouveau lien personnel de suivi, à sa demande
  MESSAGE_VANLIFE // au client : réponse de Vanlife
  MESSAGE_CLIENT // à l'équipe : message du client depuis son espace
  ANNULATION_CLIENT // à l'équipe : le client a annulé sa demande

  @@map("type_email")
}

enum StatutEmail {
  EN_ATTENTE // dans la file, pas encore envoyé (ou nouvel essai prévu)
  EN_COURS // pris en charge par l'envoi, à l'instant
  ENVOYE
  ECHEC // abandonné après plusieurs essais

  @@map("statut_email")
}

/// File d'envoi des e-mails (« outbox ») : un e-mail est enregistré dans la même transaction que
/// l'événement qui le déclenche, puis envoyé en arrière-plan avec de nouveaux essais en cas de panne.
/// Aucun e-mail n'est perdu, et une demande n'échoue jamais à cause du serveur de messagerie.
model EmailSortant {
  id                 Int         @id @default(autoincrement())
  type               TypeEmail
  demandeId          String?     @map("demande_id") @db.Uuid
  demande            Demande?    @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  destinataire       String
  sujet              String
  texte              String // version texte (lisible partout)
  html               String // version mise en forme
  statut             StatutEmail @default(EN_ATTENTE)
  tentatives         Int         @default(0)
  prochaineTentative DateTime    @default(now()) @map("prochaine_tentative")
  derniereErreur     String?     @map("derniere_erreur")
  creeLe             DateTime    @default(now()) @map("cree_le")
  envoyeLe           DateTime?   @map("envoye_le")

  @@index([statut, prochaineTentative])
  @@index([demandeId])
  @@map("emails_sortants")
}

// ---------- Espace client ----------

/// Lien personnel de suivi (« lien magique ») envoyé par e-mail au client. Comme pour les sessions,
/// la base ne garde que l'empreinte SHA-256 du secret. Valable jusqu'à 30 jours après le retour du séjour.
model AccesSuivi {
  id        String   @id // empreinte du secret
  demandeId String   @map("demande_id") @db.Uuid
  demande   Demande  @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  creeLe    DateTime @default(now()) @map("cree_le")
  expireLe  DateTime @map("expire_le")

  @@index([demandeId])
  @@map("acces_suivi")
}

enum AuteurMessage {
  CLIENT
  VANLIFE

  @@map("auteur_message")
}

/// Échange entre le client (depuis son espace de suivi) et l'équipe Vanlife (depuis le back-office).
model MessageDemande {
  id        Int           @id @default(autoincrement())
  demandeId String        @map("demande_id") @db.Uuid
  demande   Demande       @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  auteur    AuteurMessage
  auteurId  String?       @map("auteur_id") @db.Uuid // membre de l'équipe (null pour le client)
  equipier  Utilisateur?  @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  texte     String
  creeLe    DateTime      @default(now()) @map("cree_le")

  @@index([demandeId])
  @@map("messages_demandes")
}
